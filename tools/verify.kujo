from experiments.provenance import load_evidence, read_manifest, read_candidates, frozen_selection, verify_final

func stable(row, behavior) {
    let untimed := remove(row, "runtime_ms")[0]
    if behavior {
        return remove(untimed, "source_sha256")[0]
    }
    return untimed
}

func stable_manifest(manifest, behavior) {
    if behavior {
        return remove(remove(manifest, "source_sha256")[0], "source_files")[0]
    }
    return manifest
}

func final_decisions(result, selection, behavior) {
    verify_final(result, selection)
    mut compared := result
    compared["baseline"] := stable(result["baseline"], behavior)
    compared["winner"] := stable(result["winner"], behavior)
    if behavior {
        return remove(compared, "source_sha256")[0]
    }
    return compared
}

func verify_run(reference, fresh, behavior) {
    let expected := load_evidence(reference, "baseline")
    let actual := load_evidence(fresh, "baseline")
    let manifest := read_manifest(reference)
    let fresh_manifest := read_manifest(fresh)
    if !behavior && manifest["source_sha256"] != fresh_manifest["source_sha256"] {
        eprint("Evidence comes from different source revisions. Use --behavior for a cross-revision comparison.")
        exit(1)
    }
    assert_equal(stable_manifest(manifest, behavior), stable_manifest(fresh_manifest, behavior))
    assert_equal(stable(expected, behavior), stable(actual, behavior))

    let published := read_candidates(reference)
    let reproduced := read_candidates(fresh)
    let selection := frozen_selection(reference, manifest, expected, published)
    let fresh_selection := frozen_selection(fresh, fresh_manifest, actual, reproduced)
    mut phase_counts := {"exploration": 0, "refinement": 0, "challenge": 0}
    mut rejected := 0
    for index in range(0, len(published)) {
        mut candidate := published[index]
        assert_equal(stable(candidate, behavior), stable(reproduced[index], behavior))
        phase_counts[candidate["phase"]] := phase_counts[candidate["phase"]] + 1
        assert_equal(candidate["successful_replays"], 100)
        assert_equal(len(candidate["failures"]), candidate["failed_tests"])
        assert_equal(len(candidate["regressions"]), candidate["regression_count"])
        if !candidate["gate_passed"] {
            assert_equal(candidate["phase"], "challenge")
            assert_equal(candidate["critical_recalled"], 0)
            assert_equal(candidate["safety_violations"], 12)
            rejected = rejected + 1
        }
    }
    assert_equal(phase_counts, {"exploration": 120, "refinement": 72, "challenge": 8})
    assert_equal(rejected, 4)

    let final := load_evidence(reference, "final")
    let rerun := load_evidence(fresh, "final")
    assert_equal(final_decisions(final, selection, behavior), final_decisions(rerun, fresh_selection, behavior))
    assert_true(final["deployable_in_lab"])
    for key in ["baseline", "winner"] {
        assert_equal(final[key]["successful_replays"], 24)
    }
    print(to_json({"matching_candidate_records": len(published), "matching_baseline_and_heldout": true,
        "verified_rejections": rejected, "verified_winner": selection["winner"]["experiment_id"]}))
}

let argv := args()
if len(argv) < 2 || len(argv) > 3 || (len(argv) == 3 && argv[2] != "--behavior") {
    eprint("usage: verify.kujo -- ORIGINAL_EVIDENCE REPRODUCED_EVIDENCE [--behavior]")
    exit(2)
}
verify_run(argv[0], argv[1], len(argv) == 3)
