from src.model import classify, model_options

let argv := args()
if len(argv) < 2 || path_exists(argv[0]) {
    eprint("usage: record.kujo -- NEW_CASSETTE_DIR FIXTURE_JSON [FIXTURE_JSON ...]")
    exit(2)
}
assert_true(create_dir(argv[0]))
let incomplete := argv[0] + "/.replay-lab-incomplete"
assert_true(write_file_atomic(incomplete, "Recording in progress.\n"))
let options := model_options("record", argv[0])
mut count := 0
for path in slice(argv, 1, len(argv)) {
    for row in parse_json(read_file(path)) {
        mut result := classify(row["issue"], options)
        assert_equal(result["error"], null)
        assert_equal(path_exists(argv[0] + "/" + result["request_hash"] + ".json"), true)
        count = count + 1
    }
}
assert_true(count > 0)
assert_true(delete_file(incomplete))
print(to_json({"native_records": count}))
